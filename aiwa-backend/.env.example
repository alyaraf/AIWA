SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/aiwa_db
DB_USERNAME=aiwa_user
DB_PASSWORD=change-this-db-password
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=change-this-to-a-long-random-production-secret
CORS_ALLOWED_ORIGINS=https://admin.yourdomain.com
SMS_PROVIDER=external
SMS_API_URL=https://sms-provider.example/send
SMS_API_KEY=change-this-sms-api-key
SMS_SENDER=AIWA
# Email codes (email sign-up / password reset). dev-log | http
EMAIL_PROVIDER=http
EMAIL_API_URL=https://email-gateway.example/send
EMAIL_API_KEY=change-this-email-api-key
EMAIL_FROM=no-reply@yourdomain.com
# Push: Firebase Cloud Messaging HTTP v1 with a service-account JSON file
PUSH_PROVIDER=fcm
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
FCM_PROJECT_ID=
# Comma-separated on-call numbers texted on every SOS
SAFETY_ONCALL_PHONES=+201000000000
GOOGLE_MAPS_API_KEY=change-this-google-maps-key
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONE=
ADMIN_PASSWORD=change-this-admin-password
ADMIN_FULL_NAME=AIWA Admin
POSTGRES_DB=aiwa_db
POSTGRES_USER=aiwa_user
POSTGRES_PASSWORD=change-this-db-password
