# Copy to .env and fill in. Never commit .env. Generate secrets with:
#   openssl rand -base64 48
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
# Public site with /privacy, /terms and /delete-account (store listings link here)
SITE_DOMAIN=yourdomain.com
# Share links open the app (FE-13): Play Console -> App integrity -> app signing
# certificate SHA-256 (AA:BB:...), and your Apple Developer Team ID
ANDROID_CERT_SHA256=
APPLE_TEAM_ID=
ACME_EMAIL=ops@yourdomain.com

# Leave unset to use the bundled postgres container; point at a managed
# PostgreSQL (recommended, OPS-2) to replace it.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/aiwa_db?sslmode=require
POSTGRES_DB=aiwa_db
DB_USERNAME=aiwa_user
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# Access-token lifetime in ms (default 15 minutes; the apps refresh silently)
# JWT_EXPIRATION_MS=900000
# Prometheus scrape token; put the same value in secrets/metrics-token
METRICS_TOKEN=
# Error tracking (optional): the backend DSN from sentry.io
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Backups (deploy/backups)
BACKUP_KEEP_DAYS=14
# Optional heartbeat URL pinged after each verified backup (healthchecks.io, Better Stack):
# no ping for a day = an alert that backups stopped (R2-02)
BACKUP_HEARTBEAT_URL=

# Release being run: the git commit. Images are tagged with it, so a rollback is
# RELEASE_TAG=<previous> docker compose -f docker-compose.prod.yml up -d --no-build (R2-20)
RELEASE_TAG=

# Where alerts go (R2-04). Alertmanager will not start without at least one.
# Email over SMTP (host:port, e.g. email-smtp.eu-west-1.amazonaws.com:587):
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# and/or Telegram (bot from @BotFather, chat id of the on-call group):
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

SMS_PROVIDER=external
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=AIWA
EMAIL_PROVIDER=http
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
PUSH_PROVIDER=fcm
# Firebase service-account JSON goes in deploy/secrets/firebase-service-account.json (git-ignored)
FCM_PROJECT_ID=
# Comma-separated on-call numbers texted on every SOS (required in prod)
SAFETY_ONCALL_PHONES=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=AIWA Admin
