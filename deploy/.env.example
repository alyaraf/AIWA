# Copy to .env and fill in. Never commit .env. Generate secrets with:
#   openssl rand -base64 48
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
# Public site with /privacy, /terms and /delete-account (store listings link here)
SITE_DOMAIN=yourdomain.com
# Share links open the app (FE-13): Play Console -> App integrity -> app signing
# certificate SHA-256 (AA:BB:...), and your Apple Developer Team ID
ANDROID_CERT_SHA256=
APPLE_TEAM_ID=
ACME_EMAIL=ops@yourdomain.com

# Leave unset to use the bundled postgres container; point at a managed
# PostgreSQL (recommended, OPS-2) to replace it.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/aiwa_db?sslmode=require
POSTGRES_DB=aiwa_db
DB_USERNAME=aiwa_user
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# Prometheus scrape token; put the same value in secrets/metrics-token
METRICS_TOKEN=
# Error tracking (optional): the backend DSN from sentry.io
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Backups (deploy/backups)
BACKUP_KEEP_DAYS=14

SMS_PROVIDER=external
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=AIWA
EMAIL_PROVIDER=http
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
PUSH_PROVIDER=fcm
# Firebase service-account JSON goes in deploy/secrets/firebase-service-account.json (git-ignored)
FCM_PROJECT_ID=
# Comma-separated on-call numbers texted on every SOS (required in prod)
SAFETY_ONCALL_PHONES=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=AIWA Admin
