# Copy to .env and fill in. Never commit .env. Generate secrets with:
#   openssl rand -base64 48
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
# Public site with /privacy, /terms and /delete-account (store listings link here)
SITE_DOMAIN=yourdomain.com
# Share links open the app (FE-13): Play Console -> App integrity -> app signing
# certificate SHA-256 (AA:BB:...), and your Apple Developer Team ID
ANDROID_CERT_SHA256=
APPLE_TEAM_ID=
ACME_EMAIL=ops@yourdomain.com

# Leave unset to use the bundled postgres container; point at a managed
# PostgreSQL (recommended, OPS-2) to replace it.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/aiwa_db?sslmode=require
POSTGRES_DB=aiwa_db
DB_USERNAME=aiwa_user
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
# AU-08: encrypts admin 2FA (TOTP) secrets at rest. 32 random bytes, base64:
#   openssl rand -base64 32
# Keep it with the other secrets and in the backup of secrets: without it, admins with 2FA
# cannot sign in. REQUIRED: the backend and docker compose refuse to start without it (S-02).
TOTP_ENCRYPTION_KEY=
# AU-08: same idea for ID documents and selfies on the uploads volume (AES-256-GCM). A different
# key from the one above. REQUIRED. Files stored before it was set stay readable and are not rewritten.
DOCUMENT_ENCRYPTION_KEY=
# Access-token lifetime in ms (default 15 minutes; the apps refresh silently)
# JWT_EXPIRATION_MS=900000
# L-18: refresh-token lifetime for admin accounts (default 8 hours); other users keep 7 days.
# JWT_ADMIN_REFRESH_EXPIRATION_MS=28800000
# M-8: notifications older than this many days are deleted nightly (default 180; 0 keeps them).
# NOTIFICATION_RETENTION_DAYS=180
# Prometheus scrape token; put the same value in secrets/metrics-token
METRICS_TOKEN=
# Error tracking (optional): the backend DSN from sentry.io
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Backups (deploy/backups)
BACKUP_KEEP_DAYS=14
# Optional heartbeat URL pinged after each verified backup (healthchecks.io, Better Stack):
# no ping for a day = an alert that backups stopped (R2-02)
BACKUP_HEARTBEAT_URL=
# Host path of the backup encryption key (CR-20). REQUIRED: docker compose refuses to start
# without it and the backup refuses to write an unencrypted copy. Create it per docs/runbooks.md.
BACKUP_KEY_FILE=./secrets/backup.key

# Release being run: the git commit. Images are tagged with it, so a rollback is
# RELEASE_TAG=<previous> docker compose -f docker-compose.prod.yml up -d --no-build (R2-20)
RELEASE_TAG=

# Where alerts go (R2-04). Alertmanager will not start without at least one.
# Email over SMTP (host:port, e.g. email-smtp.eu-west-1.amazonaws.com:587):
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# and/or Telegram (bot from @BotFather, chat id of the on-call group):
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

SMS_PROVIDER=external
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=AIWA
# H-4: OTP texts only to these country codes (comma-separated, no "+"; empty = any), and a
# global ceiling on OTP texts per hour / day (0 = off). Defaults: 20, 1000, 10000.
# Leave these commented to keep the defaults: an empty value means "any country" / "off".
#OTP_ALLOWED_COUNTRY_CODES=20
#OTP_MAX_GLOBAL_SENDS_HOUR=1000
#OTP_MAX_GLOBAL_SENDS_DAY=10000
EMAIL_PROVIDER=http
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
PUSH_PROVIDER=fcm
# Firebase service-account JSON goes in deploy/secrets/firebase-service-account.json (git-ignored)
FCM_PROJECT_ID=
# Comma-separated on-call numbers texted on every SOS (required in prod)
SAFETY_ONCALL_PHONES=
ADMIN_EMAIL=
# First-start bootstrap only (12+ characters). After you have logged in as that admin, DELETE this
# line from .env and recreate the backend: the account stays in the database (docs/runbooks.md).
ADMIN_PASSWORD=
ADMIN_FULL_NAME=AIWA Admin
