# Copy to .env and fill in. Never commit .env. Generate secrets with:
#   openssl rand -base64 48
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
ACME_EMAIL=ops@yourdomain.com

# Leave unset to use the bundled postgres container; point at a managed
# PostgreSQL (recommended, OPS-2) to replace it.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/aiwa_db?sslmode=require
POSTGRES_DB=aiwa_db
DB_USERNAME=aiwa_user
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

SMS_PROVIDER=external
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=AIWA
EMAIL_PROVIDER=http
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
PUSH_PROVIDER=fcm
# Firebase service-account JSON goes in deploy/secrets/firebase-service-account.json (git-ignored)
FCM_PROJECT_ID=
# Comma-separated on-call numbers texted on every SOS (required in prod)
SAFETY_ONCALL_PHONES=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=AIWA Admin
