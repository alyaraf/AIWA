{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

{$API_DOMAIN} {
	import common
	# Uploads are capped at 30 MB by Spring; stop bigger bodies here.
	request_body {
		max_size 32MB
	}
	# Actuator stays internal apart from health checks.
	@actuator {
		path /api/actuator/*
		not path /api/actuator/health /api/actuator/health/*
	}
	respond @actuator 404
	reverse_proxy backend:8080
}

{$ADMIN_DOMAIN} {
	import common
	# F-19: the admin panel is for staff. ADMIN_ALLOWED_IPS (space-separated CIDRs, deploy/.env) limits who
	# can even load it; the default allows everyone, so set it to your office/VPN ranges.
	@notAllowed not remote_ip {$ADMIN_ALLOWED_IPS}
	respond @notAllowed 403
	reverse_proxy admin:8080
}

# Public site (OPS-4): privacy policy, terms and the account-deletion page the
# stores require. Only the two public read endpoints it needs reach the backend.
{$SITE_DOMAIN} {
	import common
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	header Referrer-Policy "no-referrer"
	# FE-13: App Links / Universal Links verification. ANDROID_CERT_SHA256 is the
	# Play App Signing certificate fingerprint (Play Console -> App integrity);
	# APPLE_TEAM_ID is from developer.apple.com -> Membership.
	handle /.well-known/assetlinks.json {
		header Content-Type application/json
		respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"com.aiwa.app","sha256_cert_fingerprints":["{$ANDROID_CERT_SHA256}"]}}]` 200
	}
	handle /.well-known/apple-app-site-association {
		header Content-Type application/json
		respond `{"applinks":{"details":[{"appIDs":["{$APPLE_TEAM_ID}.com.aiwa.app"],"components":[{"/":"/provider/*"}]}]}}` 200
	}
	# A shared profile link opened where the app isn't installed.
	handle /provider/* {
		rewrite * /open-app.html
		root * /srv/site
		file_server
	}
	@publicApi path /api/terms/latest /api/support/contact
	handle @publicApi {
		reverse_proxy backend:8080
	}
	handle {
		root * /srv/site
		try_files {path} {path}.html
		file_server
	}
}
